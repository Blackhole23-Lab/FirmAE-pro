#!/bin/sh

FIRMAE_BOOT=true
FIRMAE_NET=true
FIRMAE_NVRAM=true
FIRMAE_KERNEL=true
FIRMAE_ETC=true

if (${FIRMAE_ETC}); then
  TIMEOUT=120
  CHECK_TIMEOUT=120
else
  TIMEOUT=60
  CHECK_TIMEOUT=60
fi

if [ -n "${FIRMAE_DOCKER-}" ]; then
    FIRMAE_DIR=/work/FirmAE
    PSQL_IP=172.17.0.1
else
    FIRMAE_DIR=$(pwd)
    PSQL_IP=127.0.0.1
fi

BINARIES=( "busybox" "console" "gdb" "gdbserver" "strace" "libnvram.so" "libnvram_ioctl.so" )

# specify full paths to other directories
BINARY_DIR=${FIRMAE_DIR}/binaries/
TARBALL_DIR=${FIRMAE_DIR}/images/
SCRATCH_DIR=${FIRMAE_DIR}/scratch
SCRIPT_DIR=${FIRMAE_DIR}/scripts/

# functions to safely compute other paths

check_arch () {
    ARCHS=("armel" "armhf" "mipseb" "mipsel" "aarch64")

    if [ -z "${1}" ]; then
        return 0
    fi

    match=0
    for i in "${ARCHS[@]}"; do
        if [ "${1}" == "$i" ]; then
            match=1
        fi
    done

    if [ "${match}" -eq 0 ]; then
        return 0
    fi

    return 1
}

check_number () {
    if [ "${1}" -ge 0 ]; then
        return 1
    fi

    return 0
}

check_root () {
    if [ "${EUID}" -eq 0 ]; then
        return 1
    fi

    return 0
}

get_fs () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image.raw"
}

get_fs_mount () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "`get_scratch "${1}"`/image/"
}

# Kernel version matching for multi-version kernel support
# Usage: select_kernel_version ARCH FIRMWARE_KERNEL_VERSION
# Returns: path to best matching kernel binary, or empty string if no match
#
# Priority:
#   1. Exact major.minor match (e.g., firmware=4.9.x → select 4.9/)
#   2. Same major version, nearest minor (e.g., firmware=4.7 → select 4.9 or 4.4)
#   3. Nearest LTS version not lower than target (e.g., firmware=3.10 → select 4.1)
#   4. Fallback to default kernel (backward compatible)
select_kernel_version () {
    local ARCH="${1}"
    local FW_VER="${2:-}"
    local KERNEL_DIR="${BINARY_DIR}/kernels/${ARCH}"

    # If no version specified or kernels dir doesn't exist, return empty
    if [ -z "${FW_VER}" ] || [ ! -d "${KERNEL_DIR}" ]; then
        echo ""
        return
    fi

    # Extract major.minor from firmware version (e.g., "4.9.337" → "4.9")
    local TARGET_MAJOR=$(echo "${FW_VER}" | cut -d. -f1)
    local TARGET_MINOR=$(echo "${FW_VER}" | cut -d. -f2)
    local TARGET_VER="${TARGET_MAJOR}.${TARGET_MINOR}"

    # LTS versions in order (for fallback)
    local LTS_VERSIONS="2.6 3.10 4.1 4.4 4.9 4.14 4.19 5.4 5.10"

    # Determine kernel binary name based on architecture
    local KERNEL_NAME=""
    case "${ARCH}" in
        armel|armhf)
            KERNEL_NAME="zImage.${ARCH}"
            ;;
        aarch64)
            KERNEL_NAME="Image.aarch64"
            ;;
        mipseb|mipsel)
            KERNEL_NAME="vmlinux.${ARCH}"
            ;;
    esac

    # 1. Exact match
    if [ -f "${KERNEL_DIR}/${TARGET_VER}/${KERNEL_NAME}" ]; then
        echo "${KERNEL_DIR}/${TARGET_VER}/${KERNEL_NAME}"
        return
    fi

    # 2. Same major version - find nearest available minor version
    local BEST_MATCH=""
    local BEST_DIFF=999
    for VER_DIR in ${KERNEL_DIR}/*/; do
        local VER=$(basename "${VER_DIR}")
        local VER_MAJOR=$(echo "${VER}" | cut -d. -f1)
        local VER_MINOR=$(echo "${VER}" | cut -d. -f2)

        if [ "${VER_MAJOR}" = "${TARGET_MAJOR}" ] && [ -f "${VER_DIR}${KERNEL_NAME}" ]; then
            local DIFF=$((VER_MINOR - TARGET_MINOR))
            if [ ${DIFF} -lt 0 ]; then DIFF=$((-DIFF)); fi
            if [ ${DIFF} -lt ${BEST_DIFF} ]; then
                BEST_DIFF=${DIFF}
                BEST_MATCH="${VER_DIR}${KERNEL_NAME}"
            fi
        fi
    done

    if [ -n "${BEST_MATCH}" ]; then
        echo "${BEST_MATCH}"
        return
    fi

    # 3. Nearest LTS not lower than target
    for LTS in ${LTS_VERSIONS}; do
        local LTS_MAJOR=$(echo "${LTS}" | cut -d. -f1)
        local LTS_MINOR=$(echo "${LTS}" | cut -d. -f2)

        # Check if LTS >= target (compare major first, then minor)
        local IS_GE=false
        if [ "${LTS_MAJOR}" -gt "${TARGET_MAJOR}" ]; then
            IS_GE=true
        elif [ "${LTS_MAJOR}" -eq "${TARGET_MAJOR}" ] && [ "${LTS_MINOR}" -ge "${TARGET_MINOR}" ]; then
            IS_GE=true
        fi

        if ${IS_GE} && [ -f "${KERNEL_DIR}/${LTS}/${KERNEL_NAME}" ]; then
            echo "${KERNEL_DIR}/${LTS}/${KERNEL_NAME}"
            return
        fi
    done

    # 4. No match found - return empty (caller will use default)
    echo ""
}

get_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    # Try version-matched kernel if version is provided
    local FW_KERNEL_VER="${2:-}"
    if [ -n "${FW_KERNEL_VER}" ]; then
        local MATCHED_KERNEL=$(select_kernel_version "${1}" "${FW_KERNEL_VER}")
        if [ -n "${MATCHED_KERNEL}" ] && [ -f "${MATCHED_KERNEL}" ]; then
            echo "${MATCHED_KERNEL}"
            return
        fi
    fi

    # Fallback to default kernel selection (original logic)
    case "${1}" in
        armel)
            echo "${BINARY_DIR}/zImage.${1}"
            ;;
        armhf)
            echo "${BINARY_DIR}/zImage.${1}"
            ;;
        aarch64)
            echo "${BINARY_DIR}/Image.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_boot_kernel () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "${BINARY_DIR}/vmlinux.${1}"
            ;;
        armhf)
            echo "${BINARY_DIR}/vmlinux.${1}"
            ;;
        aarch64)
            echo "${BINARY_DIR}/vmlinux.${1}"
            ;;
        mipseb)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        mipsel)
            if (${FIRMAE_KERNEL}); then
              echo "${BINARY_DIR}/vmlinux.${1}.4"
            else
              echo "${BINARY_DIR}/vmlinux.${1}.2"
            fi
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_binary () {
    if check_arch "${2}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    echo "${BINARY_DIR}/${1}.${2}"
}

get_qemu () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "qemu-system-arm"
            ;;
        armhf)
            echo "qemu-system-arm"
            ;;
        aarch64)
            echo "qemu-system-aarch64"
            ;;
        mipseb)
            echo "qemu-system-mips"
            ;;
        mipsel)
            echo "qemu-system-mipsel"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_disk () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "/dev/vda1"
            ;;
        armhf)
            echo "/dev/vda1"
            ;;
        aarch64)
            echo "/dev/vda1"
            ;;
        mipseb)
            echo "/dev/sda1"
            ;;
        mipsel)
            echo "/dev/sda1"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_qemu_machine () {
    if check_arch "${1}"; then
        echo "Error: Invalid architecture!"
        exit 1
    fi

    case "${1}" in
        armel)
            echo "virt"
            ;;
        armhf)
            echo "virt"
            ;;
        aarch64)
            echo "virt"
            ;;
        mipseb)
            echo "malta"
            ;;
        mipsel)
            echo "malta"
            ;;
        *)
            echo "Error: Invalid architecture!"
            exit 1
    esac
}

get_scratch () {
    if check_number "${1}"; then
        echo "Error: Invalid image number!"
        exit 1
    fi

    echo "${SCRATCH_DIR}/${IID}"
}

check_network () {
    sleep 5

    IPS=("${@}")
    DEBUG_MODE=${IPS[-1]}
    unset 'IPS[${#IPS[@]}-1]'

    PING_RESULT=false
    PING_TIME=-1
    WEB_RESULT=false
    WEB_TIME=-1
    RET_IP="None"

    START_TIME=$(date +%s | bc)
    CURRENT_TIME=$(date +%s | bc)
    t_start=$(date +%s.%N)
    while [ ${CURRENT_TIME} -le $[${START_TIME} + ${CHECK_TIMEOUT}] ]
    do
        for IP in "${IPS[@]}"
        do
            if (curl --max-time 2 --output /dev/null --silent http://${IP} || curl --max-time 2 --output /dev/null --silent https://${IP}); then
                t_end=$(date +%s.%N)
                if (! ${WEB_RESULT}); then
                    WEB_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                if (! ${PING_RESULT}); then
                    PING_TIME=${WEB_TIME}
                fi
                PING_RESULT=true
                WEB_RESULT=true
                RET_IP=${IP}
            fi
            if (ping -c 1 ${IP} > /dev/null); then
                t_end=$(date +%s.%N)
                if (! ${PING_RESULT}); then
                    PING_TIME=$(echo "$t_end - $t_start" | bc)
                fi
                PING_RESULT=true
                RET_IP=${IP}
            fi
            sleep 1
            CURRENT_TIME=$(date +%s | bc)
        done

        if (${WEB_RESULT}); then
            break
        fi
    done

    echo "${RET_IP}" "${PING_RESULT}" "${WEB_RESULT}" "${PING_TIME}" "${WEB_TIME}"
}

get_device () {
    echo '/dev/mapper/'`ls -t /dev/mapper | head -1`
}

add_partition () {
    local IFS=$'\n'
    local IMAGE_PATH
    local DEV_PATH=""
    local FOUND=false

    losetup -Pf ${1}
    while (! ${FOUND})
    do
        sleep 1
        for LINE in `losetup`
        do
            IMAGE_PATH=`echo ${LINE} | awk '{print $6}'`
            if [ "${IMAGE_PATH}" = "${1}" ]; then
                DEV_PATH=`echo ${LINE} | awk '{print $1}'`p1
                if [ -e ${DEV_PATH} ]; then
                    FOUND=true
                fi
            fi
        done
    done

    while (! ls -al ${DEV_PATH} | grep -q "disk")
    do
        sleep 1
    done
    echo ${DEV_PATH}
}

del_partition () {
    losetup -d ${1} &> /dev/null || true
    dmsetup remove $(basename ${1}) &>/dev/null || true
    sleep 1
}
